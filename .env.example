# AI Pilot Evaluation Lab - example configuration.
# Copy to .env and adjust. Never commit real credentials.

# --- Application ---
APP_HOST=127.0.0.1
APP_PORT=8310
APP_DATA_DIR=./data
APP_FRONTEND_ORIGIN=http://127.0.0.1:8501

# Comma-separated list of permitted inference endpoint hosts (SSRF allowlist).
# The application refuses to contact any endpoint host not on this list.
ENDPOINT_ALLOWLIST=127.0.0.1,localhost

# --- Default model registration (optional; models are normally added via the UI/API) ---
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=your-configured-model
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=120
# Optional JSON object of extra headers sent with every request to this provider
# (for example, access-proxy authentication headers).
# LLM_EXTRA_HEADERS={}

# --- Cost defaults (illustrative only; configure per model in the registry) ---
# Cost figures are estimates. Configure input/output price per million tokens
# on each model record. Local infrastructure cost fields are optional.
